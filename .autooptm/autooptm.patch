@@ -0,0 +1,156 @@
+import argparse
+import json
+import os
+import time
+
+import numpy as np
+import pandas as pd
+import xarray as xr
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def build_cube(steps, nlat, nlon, seed=0):
+    rng = np.random.default_rng(seed)
+    time_ = pd.date_range("2025-01-01", periods=steps, freq="6h")
+    lat = np.linspace(-89.5, 89.5, nlat, dtype=np.float32)
+    lon = np.linspace(0.5, 359.5, nlon, dtype=np.float32)
+    hours = np.arange(steps, dtype=np.float32) * 6.0
+    seasonal = 15.0 * np.sin(2 * np.pi * hours / (365.0 * 24))[:, None, None]
+    diurnal = 4.0 * np.sin(2 * np.pi * hours / 24.0)[:, None, None]
+    latitude = (30.0 - 0.6 * np.abs(lat))[None, :, None]
+    noise = rng.standard_normal((steps, nlat, nlon), dtype=np.float32) * 2.0
+    t2m = seasonal + diurnal + latitude + noise
+    return xr.Dataset({"t2m": (("time", "lat", "lon"), t2m)},
+                      coords={"time": time_, "lat": lat, "lon": lon})
+
+
+def climatology(ds):
+    return xr.DataArray(np.asarray(ds.t2m.values).mean(axis=0, dtype=np.float32),
+                        dims=("lat", "lon"),
+                        coords={"lat": ds["lat"], "lon": ds["lon"]},
+                        name="t2m")
+
+
+def _plan(ds, steps_per_week):
+    lat = np.asarray(ds["lat"].values)
+    lon = np.asarray(ds["lon"].values)
+    time_ = np.asarray(ds["time"].values)
+
+    cats = pd.cut(lat, 18)
+    codes = np.asarray(cats.codes).astype(np.int64)
+    counts = np.bincount(codes, minlength=len(cats.categories)).astype(np.float32)
+    ok = bool((np.diff(codes) >= 0).all() and codes.min() >= 0 and (counts > 0).all())
+    starts = np.concatenate([[0], np.cumsum(counts.astype(np.int64))[:-1]])
+
+    nlon_c = lon.shape[0] // 4
+    per_day = 4
+    idx = pd.DatetimeIndex(time_)
+    daily_ok = bool(steps_per_week % per_day == 0
+                    and len(idx) > 1
+                    and (np.diff(time_).astype("timedelta64[h]").astype(int) == 6).all()
+                    and idx[0] == idx[0].normalize())
+    return {"labels": [str(c) for c in cats.categories], "counts": counts,
+            "starts": starts, "nlon_c": nlon_c, "per_day": per_day,
+            "lon_c": lon[: nlon_c * 4].reshape(nlon_c, 4).mean(axis=1),
+            "usable": ok and daily_ok and nlon_c > 0,
+            "nlat": lat.shape[0], "ndays": steps_per_week // per_day}
+
+
+def _rolling5(a, nlat):
+    out = np.zeros_like(a)
+    cnt = np.zeros(nlat, dtype=a.dtype)
+    for off in (-2, -1, 0, 1, 2):
+        lo, hi = max(0, -off), nlat - max(0, off)
+        if lo < hi:
+            out[lo:hi, :] += a[lo + off:hi + off, :]
+            cnt[lo:hi] += 1
+    out /= cnt[:, None]
+    return out
+
+
+def _weekly_summary(t2m_np, clim_np, sl_time, plan):
+    nlat, nlon_c = plan["nlat"], plan["nlon_c"]
+    n4 = nlon_c * 4
+
+    tmean = t2m_np.mean(axis=0, dtype=np.float32) - clim_np          # (lat, lon)
+    tmc = tmean[:, :n4].reshape(nlat, nlon_c, 4).mean(axis=2)        # coarsen lon
+    smooth = _rolling5(tmc, nlat)                                    # roll lat
+    bands_np = np.add.reduceat(smooth, plan["starts"], axis=0) / plan["counts"][:, None]
+
+    over = (t2m_np > (clim_np + np.float32(3.0)))
+    hot_np = over.reshape(plan["ndays"], plan["per_day"], nlat, -1) \
+                 .any(axis=1).sum(axis=(1, 2)).astype(np.int64)
+
+    bands = xr.DataArray(bands_np, dims=("lat_bins", "lon"),
+                         coords={"lat_bins": plan["labels"], "lon": plan["lon_c"]})
+    hot = xr.DataArray(hot_np, dims=("time",),
+                       coords={"time": sl_time[::plan["per_day"]]})
+    return bands, hot, xr.DataArray(tmean.mean(dtype=np.float32))
+
+
+def _weekly_summary_legacy(sl, clim):
+    """The original expression chain, kept reachable behind --legacy-path."""
+    anom = sl.t2m - clim
+    smooth = anom.rolling(lat=5, center=True, min_periods=1).mean()
+    coarse = smooth.coarsen(lon=4, boundary="trim").mean()
+    bands = coarse.groupby_bins("lat", 18).mean(dim=["lat", "time"])
+    bands = bands.assign_coords(lat_bins=[str(b) for b in bands.lat_bins.values])
+    daily_max = anom.resample(time="1D").max()
+    hot = (daily_max > 3.0).sum(dim=["lat", "lon"])
+    return bands, hot, anom.mean(dim=["time", "lat", "lon"])
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--steps", type=int, default=1460, help="6-hourly steps (1460 = one year)")
+    ap.add_argument("--lat", type=int, default=180)
+    ap.add_argument("--lon", type=int, default=360)
+    ap.add_argument("--weeks", type=int, default=52)
+    ap.add_argument("--out", default=os.path.join(HERE, "out"))
+    ap.add_argument("--legacy-path", action="store_true",
+                    help="use the original xarray expression chain per week")
+    args = ap.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+
+    t0 = time.perf_counter()
+    ds = build_cube(args.steps, args.lat, args.lon)
+    clim = climatology(ds)
+    print(f"cube: {dict(ds.sizes)} float32 {ds.t2m.nbytes / 1e6:.0f} MB, "
+          f"climatology ready ({time.perf_counter() - t0:.1f}s)", flush=True)
+
+    steps_per_week = 28  # 7 days x 4 steps
+    plan = _plan(ds, steps_per_week)
+    fast = plan["usable"] and not args.legacy_path
+    t2m_all = np.asarray(ds.t2m.values) if fast else None
+    clim_np = np.asarray(clim.values) if fast else None
+    time_all = np.asarray(ds["time"].values)
+    rows, walls = [], []
+    for week in range(args.weeks):
+        t0 = time.perf_counter()
+        a, b = week * steps_per_week, (week + 1) * steps_per_week
+        if fast:
+            bands, hot, week_mean = _weekly_summary(
+                t2m_all[a:b], clim_np, time_all[a:b], plan)
+        else:
+            sl = ds.isel(time=slice(a, b))
+            bands, hot, week_mean = _weekly_summary_legacy(sl, clim)
+        result = xr.Dataset({"anomaly_by_band": bands, "hot_cells_per_day": hot,
+                             "week_mean": week_mean})
+        result.to_netcdf(os.path.join(args.out, f"week_{week:02d}.nc"))
+        dt = time.perf_counter() - t0
+        walls.append(dt)
+        rows.append({"week": week, "s": round(dt, 4),
+                     "week_mean": float(result.week_mean),
+                     "hot_total": int(hot.sum())})
+        print(f"  week {week:2d} {dt:.3f}s mean anomaly {float(result.week_mean):+.3f} "
+              f"hot cells {int(hot.sum())}", flush=True)
+
+    with open(os.path.join(args.out, "summary.json"), "w") as fh:
+        json.dump({"weeks": rows, "total_s": sum(walls),
+                   "median_s": float(np.median(walls))}, fh, indent=1)
+    print(f"done: {len(walls)} weeks, median {np.median(walls):.3f}s, total {sum(walls):.2f}s")
+
+
+if __name__ == "__main__":
+    main()
